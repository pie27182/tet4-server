# winedbg commands for the Single Mode path. Run from the client folder:
#   winedbg ./Tet4.exe "$(cat ../tools/bootstrap-sample.txt)" < ../tools/single-mode.wdbg
# Every stop prints a backtrace, then continues. Unhandled exceptions stop too.
set $BreakOnFirstChance = 0
info share
# Channel: AutoEnter and CreateRoom replies
break *0x00445f60
break *0x00441e90
# Game: EnterRoom request, the player seated, game start and game over
break *0x60914fd0
break *0x60915600
break *0x00460dd0
break *0x00461cc0
# Game: the report reply, leaving the room
break *0x00450940
break *0x60915fc0
c
bt
c
bt
c
bt
c
bt
c
bt
c
bt
c
bt
c
bt
c
bt
c
bt
c
bt
c
bt
quit
